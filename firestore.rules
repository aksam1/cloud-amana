rules_version = '2';

// The rules for the usage counts.
//
// What this protects:
//   · ev/      — one anonymous document per page-load part. Anyone may create one, but only a
//                document that matches the shape exactly: no extra fields (so nothing about a
//                person can be smuggled in), no missing fields, and every value inside its
//                allowed range. Nobody may read them except the owner.
//   · daily/   — the owner's daily totals. The owner alone may read or write them.
//   · users/   — a reader's own synced progress (the sync batch). Only that reader may read it
//                or write it, and only the four fields it is allowed to have.
//   · anything else is denied outright.
//
// The create rule on ev/ is what keeps the counts anonymous: it accepts exactly the thirteen
// fields buildDoc() in src/lib/usageRules.js produces, and nothing else. The chosen view (Muslim
// or curious) is not one of them, so it can never be sent.
service cloud.firestore {
  match /databases/{db}/documents {

    // The owner: the one account allowed to read the counts. The supervisor fills in the uid.
    function isOwner() {
      return request.auth != null && request.auth.uid == 'OWNER_UID';
    }

    match /ev/{id} {
      // A create must hold exactly these thirteen fields, and nothing else.
      allow create: if
        request.resource.data.keys().hasOnly([
          'v', 'd', 'p', 'dev', 'lang', 'ref', 'app', 'ret', 'sec', 'pv', 'ev', 'err', 'exp'
        ]) &&
        request.resource.data.keys().hasAll([
          'v', 'd', 'p', 'dev', 'lang', 'ref', 'app', 'ret', 'sec', 'pv', 'ev', 'err', 'exp'
        ]) &&
        // the schema version
        request.resource.data.v == 1 &&
        // the day, as YYYY-MM-DD
        request.resource.data.d is string &&
        request.resource.data.d.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$') &&
        // the part of this page load
        request.resource.data.p is int &&
        request.resource.data.p >= 0 && request.resource.data.p <= 1000 &&
        // the kind of device
        request.resource.data.dev in ['phone', 'tablet', 'desktop'] &&
        // the browser language: two letters at most
        request.resource.data.lang is string &&
        request.resource.data.lang.size() <= 2 &&
        // the host name of the site the reader came from: no path, no query
        request.resource.data.ref is string &&
        request.resource.data.ref.size() <= 64 &&
        // whether the app runs installed
        request.resource.data.app is bool &&
        // how long ago this browser was first here, as a word
        request.resource.data.ret in ['new', '1d', '2-7d', '8-30d', '31d+'] &&
        // the seconds the page was in front of the reader
        request.resource.data.sec is int &&
        request.resource.data.sec >= 0 && request.resource.data.sec <= 14400 &&
        // the pages that were opened, by name
        request.resource.data.pv is map &&
        request.resource.data.pv.size() <= 30 &&
        // the events, as whitelisted names
        request.resource.data.ev is list &&
        request.resource.data.ev.size() <= 120 &&
        // the failures, cleaned
        request.resource.data.err is list &&
        request.resource.data.err.size() <= 5 &&
        // when this document may be deleted: in the future, and no more than 100 days ahead
        request.resource.data.exp is timestamp &&
        request.resource.data.exp > request.time &&
        request.resource.data.exp < request.time + duration.value(100, 'd');

      // Only the owner may read the counts, and only the owner may delete them.
      allow read, delete: if isOwner();
    }

    // The owner's daily totals: nobody else may read or write them.
    match /daily/{day} {
      allow read, write: if isOwner();
    }

    // A reader's own synced progress (the sync batch): only that reader.
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['state', 'version', 'updatedAt', 'device'])
        && request.resource.data.version == 1
        && request.resource.data.state is map;
    }

    // Everything else: denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
