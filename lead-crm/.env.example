# Copy this file to ".env" and fill in the keys as you reach each phase.
# The app runs with every line left blank: each feature just stays switched
# off until its key is added. Never share the .env file or put it in git.

# --- Phase 2: Google Maps search ---
# Google Cloud Console -> enable "Places API (New)" -> create an API key.
GOOGLE_PLACES_API_KEY=

# --- Phase 3: finding and checking emails ---
HUNTER_API_KEY=
NEVERBOUNCE_API_KEY=

# --- Phases 4 and 6: Claude scores websites and sorts replies ---
# Get an official key at https://console.anthropic.com (set a spend limit there).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Phase 5: sending emails ---
# "dry_run" sends nothing: emails are only written to the Outbox so you can read them.
# Change to "instantly" only when your inboxes are warmed up and everything else works.
OUTREACH_PROVIDER=dry_run
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=

# The web address other people use to reach this app. Preview and unsubscribe
# links in emails start with this, so real sending needs a real public address.
PUBLIC_BASE_URL=http://localhost:8000

# Set a password before putting the app online. Any username works.
ADMIN_PASSWORD=

# Optional: a Slack or Discord webhook address that gets a message when a lead says yes.
ALERT_WEBHOOK_URL=
